---
const { items } = Astro.props as { items: string[] };
---
<ul class="row">
  {items.map((x) => <li class="item">{x}</li>)}
</ul>

<style>
  .row {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: grid;
    gap: 0px;
  }
  .item {
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 12px;
    padding: 12px 14px;
    opacity: 0.95;
  }
</style>
