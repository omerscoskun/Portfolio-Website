---
import { site } from "../data/site";
import { getLangFromPath } from "../i18n/utils";

const lang = getLangFromPath(Astro.url.pathname);

const heading = lang === "tr" ? "İletişim" : "Contact";
const emailLabel = lang === "tr" ? "E-posta" : "Email";
const socialsLabel = lang === "tr" ? "Sosyal" : "Social";
---

<footer class="footer">
  <div class="grid">
    <div>
      <h3>{heading}</h3>
      <p class="muted">
        {emailLabel}:
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      {site.number ? <p class="muted">Tel: <a href={`tel:${site.number}`}>{site.number}</a></p> : null}
      {site.location ? <p class="muted">{site.location}</p> : null}

    </div>

    <div>
      <h3>{socialsLabel}</h3>
      <ul class="list">
        {site.socials.map((s) => (
          <li><a href={s.url} class="muted" target="_blank" rel="noreferrer">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <p class="copyright">
    © {new Date().getFullYear()} {site.name}
  </p>
</footer>

<style>
  .footer {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid rgba(0,0,0,0.12);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  h3 { margin: 0 0 10px; font-size: 14px; letter-spacing: 0.2px; }
  .muted { margin: 6px 0; opacity: 0.85; }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  a { text-decoration: none; font-weight: 650; }
  a:hover { text-decoration: underline; }

  .copyright {
    margin: 18px 0 0;
    opacity: 0.65;
    font-size: 12px;
  }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
