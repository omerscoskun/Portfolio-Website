---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { ClientRouter } from "astro:transitions";

const { title = site.name, description, lang="en", ogImage, page="home" } = Astro.props;

const fallbackDesc = lang === "tr" ? site.defaultDescription.tr : site.defaultDescription.en;
const desc = description ?? fallbackDesc;

const canonical = new URL(Astro.url.pathname, site.url).toString();

const og = new URL(ogImage ?? site.socialImage, site.url).toString();

const twitterSite = "";
---

<html lang={lang} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />

    <meta name="twitter:card" content="summary_large_image" />
    {twitterSite ? <meta name="twitter:site" content={twitterSite} /> : null}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />
    <ClientRouter />
  </head>

  <body>
    <main>
      <Navbar />
      <slot />
      <Footer />
    </main>
  </body>
</html>
