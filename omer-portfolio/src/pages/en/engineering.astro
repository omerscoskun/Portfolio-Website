---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/utils";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

const copy = t("en");

const featured = projects.filter((p) => p.featured);
---

<BaseLayout lang="en" title="Ömer S. Coşkun | Engineering" description="Computer engineering portfolio" page="engineering">
  <h1>{copy.nav.engineering}</h1>

  <p>
    This page highlights selected projects, technologies I use, and my current focus areas.
  </p>

<h2>Skills</h2>

<section class="skills">
  <div class="block">
    <h3>Languages</h3>
    <ul>
      <li><strong>C#</strong> (projects / apps)</li>
      <li><strong>Kotlin</strong> (Android)</li>
      <li><strong>Python</strong> (experimental work / ML)</li>
      <li><strong>SQL</strong> (basic–intermediate queries)</li>
    </ul>
  </div>

  <div class="block">
    <h3>Frameworks & Platforms</h3>
    <ul>
      <li><strong>.NET / .NET Core</strong> (layered architecture experiments)</li>
      <li><strong>ASP.NET Core</strong> (API development)</li>
      <li><strong>Entity Framework Core</strong></li>
      <li><strong>Dapper</strong></li>
      <li><strong>Android (Jetpack Compose)</strong></li>
    </ul>
  </div>

  <div class="block">
    <h3>Tools</h3>
    <ul>
      <li><strong>Git & GitHub</strong></li>
      <li><strong>Docker</strong> (basic container usage)</li>
      <li><strong>Postman</strong> (API testing / collections)</li>
      <li><strong>VS Code</strong></li>
    </ul>
  </div>

  <div class="block">
    <h3>Architecture & Practices</h3>
    <ul>
      <li><strong>RESTful APIs</strong>, JSON</li>
      <li><strong>Layered Architecture</strong> (Domain / Application / Infrastructure style)</li>
      <li><strong>OOP</strong>, <strong>SOLID</strong>, clean code principles</li>
      <li><strong>Basic refactoring</strong> for maintainability</li>
    </ul>
  </div>

  <div class="block">
    <h3>Data & Messaging</h3>
    <ul>
      <li><strong>Redis</strong> (caching concepts / experiments)</li>
      <li><strong>RabbitMQ / Kafka</strong> (messaging/event concepts – experiments)</li>
      <li><strong>ORM + SQL</strong> usage (EF Core / Dapper)</li>
    </ul>
  </div>

  <div class="block">
    <h3>AI / Experimental</h3>
    <ul>
      <li><strong>Model experiments</strong> and evaluation notes (Python)</li>
      <li><strong>Data processing</strong> / simple analysis workflows</li>
    </ul>
  </div>
</section>

<style>
  .skills{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 10px;
  }
  .block{
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 14px;
    background: rgba(255,255,255,0.04);
  }
  .block h3{
    margin: 0 0 8px;
    font-size: 14px;
    opacity: 0.9;
  }
  .block ul{
    margin: 0;
    padding-left: 18px;
  }
  .block li{ margin: 6px 0; opacity: 0.92; }
  .internships{
    margin-top: 8px;
  }
  .internshipCard{
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 16px;
    background: rgba(255,255,255,0.04);
  }
  .internshipHeader h3{
    margin: 0 0 6px;
    font-size: 16px;
  }
  .internshipMeta{
    margin: 0 0 10px;
    font-size: 13px;
    opacity: 0.85;
  }
  .internshipCard ul{
    margin: 0 0 10px;
    padding-left: 18px;
  }
  .internshipCard li{
    margin: 6px 0;
    opacity: 0.92;
  }
  .internshipStack{
    margin: 0 0 8px;
    font-size: 13px;
    opacity: 0.9;
  }
  .internshipLink{
    font-size: 13px;
  }
  @media (max-width: 900px){
    .skills{ grid-template-columns: 1fr; }
  }
</style>

<h2>Internship</h2>
<section class="internships">
  <article class="internshipCard">
    <div class="internshipHeader">
      <h3>Kuzey Marmara Otoyolu İşletme A.Ş.</h3>
      <p class="internshipMeta">Intern / IT Department • Aug 4, 2025 – Aug 29, 2025 • Istanbul / Sarıyer</p>
    </div>
    <ul>
      <li>Learned and applied SOLID principles.</li>
      <li>Observed internal company processes.</li>
      <li>Worked on backend fundamentals.</li>
      <li>Built the requested project: 4kEditorUygulaması / EditorDesk.</li>
    </ul>
    <p class="internshipStack"><strong>Technologies:</strong> .NET Core, ASP.NET, C#, Docker, PostgreSQL, Postman</p>
    <a class="internshipLink" href="https://www.kuzeymarmaraotoyolu.com/" target="_blank" rel="noreferrer">Company website</a>
  </article>
</section>

<h2>Featured Projects</h2>
{featured.length ? (
  featured.map((p) => <ProjectCard project={p} lang="en" />)
) : (
  <p>No featured projects yet.</p>
)}

<h2>All Projects</h2>
{projects.length ? (
  projects.map((p) => <ProjectCard project={p} lang="en" />)
) : (
  <p>No projects added yet.</p>
)}

</BaseLayout>
