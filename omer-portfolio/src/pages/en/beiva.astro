---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import MediaLinkCard from "../../components/MediaLinkCard.astro";
import { beiva } from "../../data/beiva";
---

<BaseLayout lang="en" title="Omer | BEIVA" description="BEIVA universe: novels, art, and music" page="beiva">
  <h1>BEIVA</h1>
  <p>{beiva.intro.en}</p>

  <section>
    <h2>Novels</h2>
    {beiva.books.map((b) => <BookCard book={b} lang="en" />)}
  </section>

  <section>
    <h2>Art</h2>
    {beiva.art.map((item) => <MediaLinkCard item={item} lang="en" />)}
  </section>

  <section>
    <h2>Music</h2>
    {beiva.music.map((item) => <MediaLinkCard item={item} lang="en" />)}
  </section>

  <section>
    <h2>YouTube</h2>
    {beiva.youtube.map((item) => <MediaLinkCard item={item} lang="en" />)}
  </section>

  <section>
    <h2>Collaboration</h2>
    <p>For reviews, collaborations, or project ideas, feel free to reach out via the links.</p>
  </section>
</BaseLayout>
