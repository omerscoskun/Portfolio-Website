---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import MediaLinkCard from "../../components/MediaLinkCard.astro";
import { beiva } from "../../data/beiva";
---

<BaseLayout lang="tr" title="Ömer | BEIVA" description="BEIVA evreni, kitaplar, çizimler ve müzikler" page="beiva">
  <h1>BEIVA</h1>
  <p>{beiva.intro.tr}</p>

  <section>
    <h2>Kitaplar</h2>
    {beiva.books.map((b) => <BookCard book={b} lang="tr" />)}
  </section>

  <section>
    <h2>Çizimler</h2>
    {beiva.art.map((item) => <MediaLinkCard item={item} lang="tr" />)}
  </section>

  <section>
    <h2>Müzikler</h2>
    {beiva.music.map((item) => <MediaLinkCard item={item} lang="tr" />)}
  </section>

  <section>
    <h2>YouTube</h2>
    {beiva.youtube.map((item) => <MediaLinkCard item={item} lang="tr" />)}
  </section>

  <section>
    <h2>İşbirliği</h2>
    <p>İnceleme, işbirliği veya proje konuşmak için bağlantılardan bana ulaşabilirsin.</p>
  </section>
</BaseLayout>
