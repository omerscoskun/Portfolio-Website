---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HighlightRow from "../../components/HighlightRow.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BookCoverCard from "../../components/BookCoverCard.astro";
import MediaLinkCard from "../../components/MediaLinkCard.astro";
import HomeHighlightCard from "../../components/HomeHighlightCard.astro";

import { projects } from "../../data/projects";
import { beiva } from "../../data/beiva";
import { site } from "../../data/site";
import ProfilePhotoCard from "../../components/ProfilePhotoCard.astro";
import MediaGalleryItem from "../../components/MediaGalleryItem.astro";

const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);

const featuredBook = beiva.books.find((b) => b.id === beiva.featured.bookId) ?? beiva.books[0];
const featuredMusic = beiva.music.find((m) => m.id === beiva.featured.musicId) ?? beiva.music[0];
const featuredYoutube = beiva.youtube.find((y) => y.id === beiva.featured.youtubeId) ?? beiva.youtube[0];
const featuredClip = beiva.clips?.[0];

const highlights = [
  "Merhaba, benim adım Ömer Sait Coşkun. Süleyman Demirel Üniversitesi Bilgisayar Mühendisliği Bölümü mezunuyum. Yazılım tarafında kendimi sürekli geliştirmeyi, yeni teknolojileri deneyerek öğrenmeyi ve öğrendiklerimi gerçek projelere dönüştürmeyi seviyorum. Özellikle problem çözme, sistematik düşünme ve bir fikri adım adım çalışır bir ürüne dönüştürme süreci beni motive ediyor. Bu süreçte yalnızca “çalışan” değil, aynı zamanda anlaşılır, sürdürülebilir ve ölçeklenebilir çözümler üretmeye özen gösteriyorum.",
  "Bunun yanında BEIVA adını verdiğim kapsamlı bir bilimkurgu evreni üzerinde çalışıyorum. Bu proje; yazarlık, dünya inşası, görsel/işitsel üretim ve içerik geliştirme gibi birçok alanı bir araya getiriyor. BEIVA sayesinde hikâye anlatımını kurgusal tutarlılıkla birleştirirken, disiplinli üretim alışkanlığı da kazanıyorum: fikirleri planlamak, parçalamak, düzenlemek ve sürekli iyileştirmek. Hem analitik düşünmeyi hem de yaratıcı üretimi aynı potada buluşturan bu yaklaşım, projelerime de doğrudan yansıyor.",
  "Kendimi geliştirme yolculuğumda hem mesleki çalışmalarımı hem de kişisel projelerimi eş zamanlı yürütmeye çalışıyorum. Yeni araçları ve yaklaşımları keşfetmeyi, öğrendiklerimi pratikte sınamayı ve ihtiyaçlara gerçekten cevap veren çözümler üretmeyi önemsiyorum. Bu web sitesinde, üzerinde çalıştığım projeleri, teknik becerilerimi ve BEIVA kapsamında yürüttüğüm yaratıcı üretimleri bir arada bulabilir; benimle iletişime geçerek iş birliği fırsatlarını değerlendirebilirsin. Teşekkürler.",
];
---

<BaseLayout lang="tr" title="Ömer S. Coşkun | Portföy" description="Engineering + BEIVA portföyü" page="home">
  <section class="hero" transition:name="hero">
    <h1>{site.name}</h1>
    <p class="lead">
      Bilgisayar Mühendisi • Yazar • İçerik üreticisi
    </p>
    <div class="cta">
      <a class="btn ghost" href="/tr/engineering">Engineering</a>
      <a class="btn ghost" href="/tr/beiva">BEIVA</a>
    </div>
  </section>

    <section class="introGrid">
    <div>
      <HighlightRow items={highlights} />
    </div>

    <ProfilePhotoCard
      src="/profile.jpg"
      alt="Ömer Sait Coşkun"
      title="Ömer Sait Coşkun"
      subtitle="Bilgisayar Mühendisi • Roman Yazarı • İçerik Üreticisi"
    />
  </section>

  <section>
    <div class="sectionHead">
      <h2>Öne Çıkan Projeler</h2>
      <a class="smallLink" href="/tr/engineering">Tümünü gör →</a>
    </div>

    {featuredProjects.length ? (
      featuredProjects.map((p) => <ProjectCard project={p} lang="tr" />)
    ) : (
      <p>Henüz öne çıkan proje eklenmedi.</p>
    )}
  </section>

<section>
  <div class="sectionHead">
    <h2>BEIVA’dan Seçkiler</h2>
    <a class="smallLink" href="/tr/beiva">Tümünü gör →</a>
  </div>

  <div class="beivaGrid">
    {featuredBook ? (
      <HomeHighlightCard
        lang="tr"
        kind="book"
        title={featuredBook.title.tr}
        note={featuredBook.logline.tr}
        tags={featuredBook.status?.tr ? [featuredBook.status.tr] : []}
        imageSrc={featuredBook.cover?.src}
        imageAlt={featuredBook.cover?.alt?.tr}
        href="/tr/beiva"
      />
    ) : null}

    {featuredMusic ? (
      <HomeHighlightCard
        lang="tr"
        kind="youtube"
        title={featuredMusic.title.tr}
        note={featuredMusic.note?.tr}
        tags={featuredMusic.tags}
        youtubeUrl={featuredMusic.links.youtube}
        href="/tr/beiva"
      />
    ) : null}

    {featuredYoutube ? (
      <HomeHighlightCard
        lang="tr"
        kind="youtube"
        title={featuredYoutube.title.tr}
        note={featuredYoutube.note?.tr}
        tags={featuredYoutube.tags}
        youtubeUrl={featuredYoutube.links.youtube}
        href="/tr/beiva"
      />
    ) : null}

    {featuredClip ? (
      <HomeHighlightCard
        lang="tr"
        kind="clip"
        title={featuredClip.title.tr}
        note={featuredClip.note?.tr}
        mp4Src={featuredClip.src}
        href="/tr/beiva"
      />
    ) : null}
  </div>
</section>




  <style>
    .hero { margin: 6px 0 10px; }
    .lead { margin: 10px 0 14px; opacity: 0.9; font-size: 16px; }

    .cta { display: flex; gap: 10px; flex-wrap: wrap; margin: 12px 0 10px; }
    .btn{
      display:inline-block;
      padding: 10px 14px;
      border-radius: 14px;
      text-decoration:none;
      font-weight: 800;
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.06);
      transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease), background var(--dur) var(--ease);
    }

    .btn:hover{ transform: translateY(-2px); border-color: rgba(255,255,255,0.28); }

    .btn.primary{
      background: linear-gradient(135deg, rgba(124,92,255,0.9), rgba(56,189,248,0.55));
      border-color: rgba(255,255,255,0.18);
    }

    .ghost { opacity: 0.85; }

    .introGrid{
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 18px;
      align-items: start;
      margin-top: 10px;
    }

    .photo{
      justify-self: end;
    }

    @media (max-width: 980px){
      .introGrid{ grid-template-columns: 1fr; }
      .photo{ justify-self: start; }
    }


    .sectionHead {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      margin-top: 22px;
    }
    .smallLink { text-decoration: none; font-weight: 700; opacity: 0.85; }
    .smallLink:hover { text-decoration: underline; opacity: 1; }

    .beivaGrid{
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 14px;
  row-gap: 42px;   
  margin-top: 10px;

  align-items: start;
  isolation: isolate;         
  position: relative;
  z-index: 0;
}

.beivaGrid > *{
  position: relative;
  z-index: 0;
  transform: none !important; 
  margin-top: 0 !important;    
}

@media (max-width: 900px){
  .beivaGrid{ grid-template-columns: 1fr; }
}

  </style>
</BaseLayout>
