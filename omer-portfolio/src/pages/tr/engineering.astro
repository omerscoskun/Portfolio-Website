---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n/utils";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

const copy = t("tr");

const featured = projects.filter((p) => p.featured);
---

<BaseLayout lang="tr" title="Ömer S. Coşkun | Mühendislik" description="Bilgisayar mühendisliği portföyü" page="engineering">
  <h1>{copy.nav.engineering}</h1>

  <p>
    Bu sayfa; seçili projelerimi, kullandığım teknolojileri ve çalışma odağımı özetler.
  </p>

  <h2>Öne Çıkan Projeler</h2>
  {featured.length ? (
    featured.map((p) => <ProjectCard project={p} lang="tr" />)
  ) : (
    <p>Henüz öne çıkan proje eklenmedi.</p>
  )}

  <h2>Tüm Projeler</h2>
  {projects.length ? (
    projects.map((p) => <ProjectCard project={p} lang="tr" />)
  ) : (
    <p>Henüz proje eklenmedi.</p>
  )}

<h2>Yetenekler</h2>

<section class="skills">
  <div class="block">
    <h3>Diller</h3>
    <ul>
      <li><strong>C#</strong> (projeler / uygulamalar)</li>
      <li><strong>Kotlin</strong> (Android)</li>
      <li><strong>Python</strong> (deneysel çalışmalar / ML)</li>
      <li><strong>SQL</strong> (temel–orta seviye sorgular)</li>
    </ul>
  </div>

  <div class="block">
    <h3>Framework & Platform</h3>
    <ul>
      <li><strong>.NET / .NET Core</strong> (katmanlı mimari denemeleri)</li>
      <li><strong>ASP.NET Core</strong> (API geliştirme)</li>
      <li><strong>Entity Framework Core</strong></li>
      <li><strong>Dapper</strong></li>
      <li><strong>Android (Jetpack Compose)</strong></li>
    </ul>
  </div>

  <div class="block">
    <h3>Araçlar</h3>
    <ul>
      <li><strong>Git & GitHub</strong></li>
      <li><strong>Docker</strong> (temel container kullanımı)</li>
      <li><strong>Postman</strong> (API test / koleksiyonlar)</li>
      <li><strong>VS Code</strong></li>
    </ul>
  </div>

  <div class="block">
    <h3>Mimari & Pratikler</h3>
    <ul>
      <li><strong>RESTful API</strong>, JSON</li>
      <li><strong>Katmanlı Mimari</strong> (Domain / Application / Infrastructure yaklaşımı)</li>
      <li><strong>OOP</strong>, <strong>SOLID</strong>, temiz kod prensipleri</li>
      <li><strong>Temel performans/maintainability</strong> odaklı refactor</li>
    </ul>
  </div>

  <div class="block">
    <h3>Veri & Mesajlaşma</h3>
    <ul>
      <li><strong>Redis</strong> (cache mantığı / denemeler)</li>
      <li><strong>RabbitMQ / Kafka</strong> (event/messaging konseptleri – denemeler)</li>
      <li><strong>ORM + SQL</strong> birlikte kullanımı (EF Core / Dapper)</li>
    </ul>
  </div>

  <div class="block">
    <h3>AI / Deneysel</h3>
    <ul>
      <li><strong>Model denemeleri</strong> ve değerlendirme notları (Python)</li>
      <li><strong>Veri işleme</strong> / basit analiz süreçleri</li>
    </ul>
  </div>
</section>

<style>
  .skills{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 10px;
  }
  .block{
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 14px;
    background: rgba(255,255,255,0.04);
  }
  .block h3{
    margin: 0 0 8px;
    font-size: 14px;
    opacity: 0.9;
  }
  .block ul{
    margin: 0;
    padding-left: 18px;
  }
  .block li{ margin: 6px 0; opacity: 0.92; }
  @media (max-width: 900px){
    .skills{ grid-template-columns: 1fr; }
  }
</style>

</BaseLayout>
